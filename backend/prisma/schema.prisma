generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FOUNDER
  ADMIN
  CUSTOMER
  RELIGIOUS_PARTNER
}

enum GovernanceStatus {
  DRAFT
  FOUNDER_APPROVED
  ERP_LOCKED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum GovernanceAction {
  CREATE
  EDIT
  FOUNDER_APPROVE
  ERP_LOCK
  PUBLISH
  SUPERSEDE
  ROLLBACK
  ARCHIVE
}

model User {

  id        String   @id @default(cuid())

  fullName  String

  email     String   @unique

  password  String

  role      UserRole @default(CUSTOMER)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ownedRequests    UniversalRequest[] @relation("CustomerRequests")
  assignedRequests UniversalRequest[] @relation("PartnerAssignments")
  religiousPartnerProfile ReligiousPartner?

}

model Customer {
  id          String   @id @default(cuid())

  fullName    String
  mobile      String
  whatsapp    String?
  email       String?

  city        String?
  state       String?
  country     String?

  purpose     String
  serviceType String?

  status      String   @default("New")

  assignedTo  String?

  remarks     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReligiousPartner {

  id                     String   @id @default(cuid())

  userId                 String?  @unique
  user                   User?    @relation(fields: [userId], references: [id])

  fullName               String

  category               String

  mobile                 String

  whatsapp               String?

  email                  String?

  city                   String?

  state                  String?

  country                String?

  preferredServiceArea   String?

  onlineAvailable        Boolean @default(true)

  offlineAvailable       Boolean @default(true)

  relocationAvailable    Boolean @default(false)

  identityVerified       Boolean @default(false)

  addressVerified        Boolean @default(false)

  qualificationVerified  Boolean @default(false)

  verificationDate       DateTime?

  status                 String  @default("Pending")

  remarks                String?

  createdAt              DateTime @default(now())

  updatedAt              DateTime @updatedAt
}

model PitruMokshaRequest {

  id                     String   @id @default(cuid())

  customerName           String

  mobile                 String

  whatsapp               String?

  email                  String?

  country                String?

  state                  String?

  city                   String?

  serviceMode            String

  ritualType             String

  preferredDate          DateTime?

  preferredTime          String?

  language               String?

  samagriRequired        Boolean @default(false)

  documentationRequired  Boolean @default(false)

  travelAssistance       Boolean @default(false)

  specialRequirements    String?

  status                 String   @default("New")

  quotationStatus        String   @default("Pending")

  assignedPartner        String?

  founderRemarks         String?

  createdAt              DateTime @default(now())

  updatedAt              DateTime @updatedAt
}

model UniversalRequest {
  id                    String   @id @default(cuid())
  referenceId           String   @unique
  requestType           String
  serviceDomain         String?
  customerId            String?
  customer              User?    @relation("CustomerRequests", fields: [customerId], references: [id])
  guestName             String
  guestPhone            String
  guestEmail            String
  title                  String
  description            String
  currentStatus          String   @default("SUBMITTED")
  currentStage           String   @default("Submitted")
  assignedTeam           String?
  assignedPartnerUserId String?
  assignedPartner        User?    @relation("PartnerAssignments", fields: [assignedPartnerUserId], references: [id])
  priority               String   @default("MEDIUM")
  sourceChannel          String   @default("WEBSITE_FORM")
  publicNote             String?
  internalNote           String?
  metadata               Json?
  completedAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  history                UniversalRequestStatusHistory[]

  @@index([customerId, createdAt])
  @@index([assignedPartnerUserId, currentStatus])
  @@index([requestType, currentStatus])
}

model UniversalRequestStatusHistory {
  id              String           @id @default(cuid())
  requestId       String
  request         UniversalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  previousStatus  String?
  newStatus       String
  previousStage   String?
  newStage        String
  changedByUserId String?
  changedByRole   String
  publicNote      String?
  internalNote    String?
  createdAt       DateTime         @default(now())

  @@index([requestId, createdAt])
}

model KnowledgeArticle {
  id            String   @id @default(cuid())
  category      String
  categoryTitle String
  title         String
  keywords      String[]
  synonyms      String[]
  summary       String
  content       String
  link          String
  status        String   @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, WITHDRAWN
  governanceStatus GovernanceStatus @default(DRAFT)
  version       Int      @default(1)
  publishedAt   DateTime?
  contentKey    String?
  founderApprovedAt DateTime?
  founderApprovedBy String?
  erpLockedAt   DateTime?
  erpLockedBy   String?
  publishedVersionId String?
  createdBy     String?
  lastEditedBy  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  history       KnowledgeArticleHistory[]

  @@index([category, status])
  @@index([contentKey])
  @@index([governanceStatus, contentKey])
  @@unique([contentKey, governanceStatus])
}

model KnowledgeFAQ {
  id          String   @id @default(cuid())
  category    String
  question    String
  answer      String
  keywords    String[]
  link        String
  status      String   @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, WITHDRAWN
  governanceStatus GovernanceStatus @default(DRAFT)
  version     Int      @default(1)
  publishedAt DateTime?
  contentKey  String?
  founderApprovedAt DateTime?
  founderApprovedBy String?
  erpLockedAt DateTime?
  erpLockedBy String?
  publishedVersionId String?
  createdBy   String?
  lastEditedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  history     KnowledgeFAQHistory[]

  @@index([category, status])
  @@index([contentKey])
  @@index([governanceStatus, contentKey])
  @@unique([contentKey, governanceStatus])
}

model KnowledgeArticleHistory {
  id          String           @id @default(cuid())
  articleId   String
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  summary     String
  content     String
  link        String
  status      String
  changedBy   String
  action      GovernanceAction?
  changedByRole UserRole?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([articleId, version])
  @@index([articleId, createdAt])
}

model KnowledgeFAQHistory {
  id        String           @id @default(cuid())
  faqId     String
  faq       KnowledgeFAQ     @relation(fields: [faqId], references: [id], onDelete: Cascade)
  version   Int
  question  String
  answer    String
  link      String
  status    String
  changedBy String
  action    GovernanceAction?
  changedByRole UserRole?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([faqId, version])
  @@index([faqId, createdAt])
}

model GovernanceAuditLog {
  id          String           @id @default(cuid())
  contentType String           // "ARTICLE" | "FAQ"
  contentId   String           // The specific article/faq id
  contentKey  String?          // Stable content identifier
  version     Int              // Version number at time of action
  action      GovernanceAction
  actorUserId String?          // User who performed action
  actorRole   UserRole
  metadata    Json?            // Additional context
  createdAt   DateTime         @default(now())

  @@index([contentType, contentId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
