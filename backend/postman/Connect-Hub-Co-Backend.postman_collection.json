{
  "info": {
    "name": "Connect Hub Co Backend",
    "description": "Express API at backend/src. Default local port is 5050 (macOS AirPlay uses 5000).\n\nBearer token: run Auth → Login (or Register then Login). The test script stores `token` in `accessToken`.\n\nRoles: CUSTOMER (register default), RELIGIOUS_PARTNER, ADMIN, FOUNDER. Admin/Founder users must be set in Postgres (`User.role`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050" },
    { "key": "accessToken", "value": "" },
    { "key": "email", "value": "customer@example.test" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "fullName", "value": "Local Customer" },
    { "key": "referenceId", "value": "CHC-2026-123456" },
    { "key": "contactVerification", "value": "guest@example.test" },
    { "key": "customerId", "value": "" },
    { "key": "partnerId", "value": "" },
    { "key": "partnerUserId", "value": "" },
    { "key": "articleId", "value": "" },
    { "key": "faqId", "value": "" },
    { "key": "quotationId", "value": "" },
    { "key": "agreementId", "value": "" },
    { "key": "serviceSlug", "value": "pitru-moksha-gaya" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Auth health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (creates CUSTOMER)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (saves accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.collectionVariables.set('accessToken', json.token);",
                  "    if (json.user && json.user.id) pm.collectionVariables.set('partnerUserId', json.user.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "URMS",
      "item": [
        {
          "name": "Create public request (optional Bearer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestType\": \"SERVICE_REQUEST\",\n  \"serviceDomain\": \"pitru-moksha-gaya\",\n  \"guestName\": \"Guest Devotee\",\n  \"guestPhone\": \"9999999999\",\n  \"guestEmail\": \"{{contactVerification}}\",\n  \"title\": \"Pind Daan enquiry\",\n  \"description\": \"Need offline ritual assistance in Gaya.\",\n  \"priority\": \"MEDIUM\",\n  \"sourceChannel\": \"WEBSITE_FORM\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/public",
            "description": "requestType: INQUIRY | BOOKING | SERVICE_REQUEST | PARTNER_REGISTRATION | COMPLAINT | GRIEVANCE | FOUNDER_SUPPORT | OTHER. Commercial workflow endpoints require SERVICE_REQUEST. Send Bearer as CUSTOMER to attach customerId."
          }
        },
        {
          "name": "Track by reference + contact",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"{{referenceId}}\",\n  \"contactVerification\": \"{{contactVerification}}\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/track"
          }
        },
        {
          "name": "Customer quotation decision",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotationId\": \"{{quotationId}}\",\n  \"decision\": \"ACCEPT\",\n  \"contactVerification\": \"{{contactVerification}}\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}/quotation-decision",
            "description": "decision: ACCEPT | REQUEST_CHANGE | REJECT. For REQUEST_CHANGE also send changeRequest."
          }
        },
        {
          "name": "Customer accept agreement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agreementId\": \"{{agreementId}}\",\n  \"agreementVersion\": 1,\n  \"contactVerification\": \"{{contactVerification}}\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}/agreement-acceptance"
          }
        },
        {
          "name": "Customer submit payment details",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaid\": \"5000\",\n  \"paymentDate\": \"2026-09-10\",\n  \"externalReference\": \"UTR123456\",\n  \"paymentMode\": \"NEFT\",\n  \"payerName\": \"Guest Devotee\",\n  \"remarks\": \"Paid from HDFC\",\n  \"contactVerification\": \"{{contactVerification}}\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}/payment-details",
            "description": "paymentMode: BANK_TRANSFER | NEFT | RTGS | IMPS"
          }
        },
        {
          "name": "List mine (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/urms/universal-requests/mine"
          }
        },
        {
          "name": "List assigned to me (RELIGIOUS_PARTNER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/urms/universal-requests/assigned-to-me"
          }
        },
        {
          "name": "Eligible partners (ADMIN/FOUNDER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/urms/universal-requests/eligible-partners"
          }
        },
        {
          "name": "List all (ADMIN/FOUNDER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/urms/universal-requests"
          }
        },
        {
          "name": "Get by referenceId (role-scoped)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}"
          }
        },
        {
          "name": "Admin patch request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentStatus\": \"ACKNOWLEDGED\",\n  \"currentStage\": \"Acknowledged\",\n  \"assignedTeam\": \"Operations\",\n  \"assignedPartnerUserId\": \"{{partnerUserId}}\",\n  \"publicNote\": \"We have received your request.\",\n  \"internalNote\": \"Assign after verification.\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}"
          }
        },
        {
          "name": "Partner patch status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"publicNote\": \"Work started.\"\n}"
            },
            "url": "{{baseUrl}}/api/urms/universal-requests/{{referenceId}}/partner-status",
            "description": "status: IN_PROGRESS | COMPLETED. RELIGIOUS_PARTNER only; 204 on success."
          }
        }
      ]
    },
