+  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
+  transition: all 0.2s ease;
+}
+
+.carouselArrow:hover {
+  background: #fff8e7;
+  border-color: var(--ritual-gold);
+  transform: translateY(-50%) scale(1.08);
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.32);
+}
+
+.carouselArrow:focus-visible {
+  outline: 3px solid #ffd762;
+  outline-offset: 2px;
+}
+
+.previous {
+  left: -18px;
+}
+
+.next {
+  right: -18px;
+}
+
+
+
+/* =========================================================
+   HORIZONTAL CORE SERVICES
+   ========================================================= */
+
+.heroCoreServices {
+  grid-area: core;
+
+  width: 100%;
+  min-width: 0;
+
+  margin: 0;
+}
+
+.coreServices {
+  box-sizing: border-box;
+
+  width: 100%;
+
+  border: 1px solid rgba(213, 154, 8, 0.68);
+  border-radius: 13px;
+
+  padding: 14px 16px;
+
+  background: var(--shell-peacock-trust);
+}
+
+.coreServices h2 {
+  margin: 0 0 10px;
+
+  color: var(--ritual-gold);
+
+  font-family: Georgia, "Times New Roman", serif;
+
+  font-size: 1.25rem;
+
+  text-align: center;
+}
+
+.serviceGrid {
+  display: grid;
+  grid-template-columns: repeat(10, minmax(0, 1fr));
+  gap: 0;
+}
+
+.serviceCard {
+  display: flex;
+
+  min-width: 0;
+  min-height: 72px;
+
+  flex-direction: column;
+
+  align-items: center;
+  justify-content: center;
+
+  border-right: 1px solid rgba(255, 255, 255, 0.18);
+
+  padding: 6px 4px;
+
+  color: #fff;
+
+  font-size: 0.72rem;
+
+  line-height: 1.2;
+  text-align: center;
+}
+
+.serviceCard:last-child {
+  border-right: 0;
+}
+
+.serviceCard > span {
+  margin-bottom: 3px;
+
+  color: var(--ritual-gold);
+
+  font-size: 1.3rem;
+}
+
+.serviceCard strong {
+  font-weight: 500;
+}
+
+/* =========================================================
+   RESPONSIVE — TABLET
+   ========================================================= */
+
+@media (max-width: 1200px) {
+  .religiousPartnerContent {
+    width: 56%;
+
+    padding-inline: 27px 18px;
+  }
+
+  .religiousPartnerContent h1 {
+    font-size: 3rem;
