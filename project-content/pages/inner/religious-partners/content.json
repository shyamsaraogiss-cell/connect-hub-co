        {
          "kind": "field:title",
          "line": 351,
          "value": "Who can apply as a Religious Partner?"
        },
        {
          "kind": "field:description",
          "line": 352,
          "value": "Qualified Pandits, Purohits, Pandas, Acharyas, Vaidik Scholars, and traditional specialists with verified background credentials and traditional experience."
        },
        {
          "kind": "field:title",
          "line": 355,
          "value": "How verification works"
        },
        {
          "kind": "field:description",
          "line": 356,
          "value": "Identity checks, document verification, background screening, and reference checks conducted neutrally by our partner onboarding team."
        },
        {
          "kind": "field:title",
          "line": 359,
          "value": "Information required before registration"
        },
        {
          "kind": "field:description",
          "line": 360,
          "value": "Basic contact details, service locations, languages spoken, ritual specializations, experience years, and identity details."
        },
        {
          "kind": "field:title",
          "line": 363,
          "value": "Online versus offline service readiness"
        },
        {
          "kind": "field:description",
          "line": 364,
          "value": "Guidelines for conducting physical in-person rites vs technical readiness required for live-streamed remote family participation."
        },
        {
          "kind": "field:title",
          "line": 367,
          "value": "Partner responsibilities"
        },
        {
          "kind": "field:description",
          "line": 368,
          "value": "Maintaining authentic Vaidik Vidhi, punctuality, transparent pricing, respectful conduct, customer confidentiality, and ethical service standards."
        },
        {
          "kind": "field:title",
          "line": 371,
          "value": "How customer inquiries are coordinated"
        },
        {
          "kind": "field:description",
          "line": 372,
          "value": "Matching algorithms based on tradition, location, language preference, Gotra requirement (for Panda Vahi ledgers), and partner availability."
        },
        {
          "kind": "field:title",
          "line": 375,
          "value": "Pricing and service-scope transparency"
        },
        {
          "kind": "field:description",
          "line": 376,
          "value": "Fixed confirmed pricing established upfront without unauthorized extra demands, hidden fees, or high-pressure tactics."
        },
        {
          "kind": "field:title",
          "line": 379,
          "value": "What happens after application"
        },
        {
          "kind": "field:description",
          "line": 380,
          "value": "Administrative review, credential verification, profile orientation, service terms confirmation, and active network onboarding."
        },
        {
          "kind": "field:question",
          "line": 386,
          "value": "Does registration guarantee approval?"
        },
        {
          "kind": "field:answer",
          "line": 387,
          "value": "No. Registration is an initial application process. Network membership and service assignments depend on verified credentials, location feasibility, and adherence to approved ethical standards."
        },
        {
          "kind": "field:question",
          "line": 390,
          "value": "Who can apply as a Religious Partner?"
        },
        {
          "kind": "field:answer",
          "line": 391,
          "value": "Qualified Pandits, Purohits, Pandas, Acharyas, and Vaidik Scholars who possess verified traditional training, proven ritual experience, and valid identity documentation."
        },
        {
          "kind": "field:question",
          "line": 394,
          "value": "What information is required to begin?"
        },
        {
          "kind": "field:answer",
          "line": 395,
          "value": "Basic details including full name, traditional title, phone number, email, service locations, languages spoken, ritual specializations, experience years, and identity proof details."
        },
        {
          "kind": "field:question",
          "line": 398,
          "value": "Can I offer multiple ritual services?"
        },
        {
          "kind": "field:answer",
          "line": 399,
          "value": "Yes. Partners may list all ritual domains in which they possess verified traditional competence—such as Pind Daan, Havan, Griha Pravesh, or Vahi Records guidance."
        },
        {
          "kind": "field:question",
          "line": 402,
          "value": "Can I serve more than one city?"
        },
        {
          "kind": "field:answer",
          "line": 403,
          "value": "Yes. Partners can indicate all operational cities, states, or sacred pilgrimage hubs where they can travel or maintain physical service capabilities."
        },
        {
          "kind": "field:question",
          "line": 406,
          "value": "Can I provide online rituals?"
        },
        {
          "kind": "field:answer",
          "line": 407,
          "value": "Yes. Qualified partners with appropriate technical readiness and clear communication skills can conduct approved live-streamed online ceremonies."
        },
        {
          "kind": "field:question",
          "line": 410,
          "value": "How are customer inquiries assigned?"
        },
        {
          "kind": "field:answer",
          "line": 411,
          "value": "Inquiries are matched objectively based on customer location, language preference, specific ritual specialization, Gotra requirements (for Panda Vahi ledgers), and partner availability."
        },
        {
          "kind": "field:question",
          "line": 414,
          "value": "Is income or booking volume guaranteed?"
        },
        {
          "kind": "field:answer",
          "line": 415,
          "value": "No. Connect Hub Co. does not promise guaranteed bookings, fixed income, commissions, or automatic customer assignments. Inquiries depend on customer demand and suitability."
        },
        {
          "kind": "field:question",
          "line": 418,
          "value": "How are prices and inclusions handled?"
        },
        {
          "kind": "field:answer",
          "line": 419,
          "value": "All service prices, samagri inclusions, and ritual steps are confirmed transparently with families upfront. Partners must adhere strictly to agreed terms without extra demands."
        },
        {
          "kind": "field:question",
          "line": 422,
          "value": "What happens if documents are incomplete?"
        },
        {
          "kind": "field:answer",
          "line": 423,
          "value": "Our partner onboarding team will contact you to request missing supporting details or clarify incomplete information before completing your review."
        },
        {
          "kind": "field:question",
          "line": 426,
          "value": "Can an application be reviewed again?"
        },
        {
          "kind": "field:answer",
          "line": 427,
          "value": "Yes. If an application requires additional credentials or location updates, partners may re-submit updated information for administrative review."
        },
        {
          "kind": "field:question",
          "line": 430,
          "value": "How is partner performance evaluated?"
        },
        {
          "kind": "field:answer",
          "line": 431,
          "value": "Partner evaluation is based on customer feedback, punctuality, adherence to Vaidik standards, transparent pricing compliance, and professional conduct."
        },
