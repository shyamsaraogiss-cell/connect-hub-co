        },
        {
          "kind": "jsx-text",
          "line": 268,
          "value": "Provides localized coordination, destination guidance, and safety-focused activity planning for coastal and beach journeys.\r\n            "
        },
        {
          "kind": "field:name",
          "line": 272,
